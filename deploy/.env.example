# Copy to deploy/.env (git-ignored) on the server and fill in. compose.yaml reads it; the api
# container gets every variable from it, so new server variables go here too. Generate secrets
# with `openssl rand -hex 32`.

# --- Required ------------------------------------------------------------------------------------
# Domain of the API, e.g. api.example.com: its DNS A/AAAA record points at this machine, and
# ports 80 and 443 reach it from the internet. `:80` serves plain HTTP for local network tests.
API_DOMAIN=
# HMAC key for device ids and IP addresses in logs and counters. Never change it once set:
# a new key resets every device's daily limit and splits the beta metrics.
DEVICE_ID_HASH_KEY=
# Token between the API server and the counter store; both containers get it from here.
COUNTER_STORE_TOKEN=

# --- Optional ------------------------------------------------------------------------------------
# Host ports Caddy listens on (default 80 and 443). Let's Encrypt still needs 80 and 443 from the
# internet: forward them to these on the router.
HTTP_PORT=
HTTPS_PORT=
# The model. Empty: qwen3.6:35b in the llm container (24 GB, needs about 28 GB of free memory),
# a 32K context and thinking off. A smaller one for tests, e.g. gemma4:e2b.
LLM_MODEL=
LLM_CONTEXT_LENGTH=
LLM_REASONING_EFFORT=
# Another model behind an OpenAI-compatible API (SPEC D-6): its address up to /v1 and its key.
LLM_BASE_URL=
LLM_API_KEY=
# `mock` answers with synthetic fixtures instead of the model (LLM_MOCK_FIXTURE, LLM_MOCK_DELAY_MS).
LLM_PROVIDER=
LLM_MOCK_FIXTURE=
LLM_MOCK_DELAY_MS=
# Apps below this major.minor.patch get 426 upgrade_required. Empty: every version.
MIN_APP_VERSION=
# Analysis attempts per IP address per hour (default 60) and the daily model budget in USD
# (empty: no cap).
IP_ATTEMPTS_PER_HOUR=
DAILY_BUDGET_USD=
# Bearer token of GET /api/v1/metrics, at least 32 characters. Empty: the route answers 404.
METRICS_TOKEN=
