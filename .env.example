# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* variables reach the app,
# and they are inlined into the bundle — never put secrets here.
# Read them through src/lib/env.ts, not process.env directly.

# Origin of this app's API routes (/api/v1/*): the server in deploy/ (https://api.example.com,
# or http://<LAN address> on the local network, which app.config.js then allows on Android), or
# the dev server reachable from the device. Only analysis and limits use it; local data never does.
EXPO_PUBLIC_API_URL=

# --- Server only (API routes, read in src/server) ---------------------------------------------
# The dev server reads them from .env.local; the server in deploy/ from deploy/.env and
# deploy/compose.yaml (deploy/.env.example). Real keys go there, never into this file.

# LLM provider of the analysis jobs (/api/v1/analyses). Empty: MockLlmProvider, which returns
# synthetic fixtures.
# `openai-compatible`: a model behind an OpenAI-compatible API (Ollama, vLLM, an EU API) — needs
# LLM_BASE_URL (up to /v1), LLM_MODEL and PDF_RENDER_URL; LLM_API_KEY and LLM_REASONING_EFFORT
# (e.g. `none`) are optional. deploy/compose.yaml sets them for its own model.
LLM_PROVIDER=
# Mock only: which fixture it returns (invoice, officialNotice, contract, fraudulentInvoice,
# unreadable) and how long it takes in ms (to watch the queue and progress or load the server).
LLM_MOCK_FIXTURE=
LLM_MOCK_DELAY_MS=
# Apps below this major.minor.patch get 426 upgrade_required. Empty: every version.
MIN_APP_VERSION=
# HMAC key for device ids in server logs. Every server sets its own secret (deploy/.env); empty
# uses a development key anyone can reproduce.
DEVICE_ID_HASH_KEY=
# Counter store for limits and beta metrics: Redis over the Upstash REST API (SPEC §8.3), which
# deploy/compose.yaml sets for its own Redis. Empty: counters in the dev server's memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Analysis attempts per IP address per hour (default 60) and the daily model budget in USD
# (empty: no cap).
IP_ATTEMPTS_PER_HOUR=
DAILY_BUDGET_USD=
# Bearer token of GET /api/v1/metrics, at least 32 characters. Empty: the route answers 404.
METRICS_TOKEN=
# Analysis jobs, kept in the server's memory (SPEC §7.1): how many are analyzed at once (default 1),
# how many wait in the queue before uploads get 503 (default 20) and how many hours a finished job
# waits for the app (default 24).
ANALYSIS_CONCURRENCY=
ANALYSIS_QUEUE_MAX=
ANALYSIS_RESULT_TTL_HOURS=
