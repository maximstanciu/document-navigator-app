# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* variables reach the app,
# and they are inlined into the bundle — never put secrets here.
# Read them through src/lib/env.ts, not process.env directly.

# Origin of this app's API routes (/api/v1/*): an EAS Hosting deployment, or the dev server
# reachable from the device. Only analysis and limits use it; local data never does.
EXPO_PUBLIC_API_URL=
# How long the app waits for an analysis, in ms. Empty: 90000. Builds for the self-hosted backend,
# whose model runs on a CPU, wait 1800000 (30 min, deploy/README.md).
EXPO_PUBLIC_ANALYZE_TIMEOUT_MS=

# --- Server only (API routes, read in src/server) ---------------------------------------------
# The dev server reads them from .env.local; `eas deploy` uploads .env.local too, and EAS
# environment variables (`--environment`) take precedence. Keys go into EAS, not into files.

# LLM provider of /api/v1/analyze. Empty: MockLlmProvider, which returns synthetic fixtures.
# `openai-compatible`: a model behind an OpenAI-compatible API (Ollama, vLLM, an EU API) — needs
# LLM_BASE_URL (up to /v1), LLM_MODEL and PDF_RENDER_URL; LLM_API_KEY and LLM_REASONING_EFFORT
# (e.g. `none`) are optional. deploy/compose.yaml sets them for its own model.
LLM_PROVIDER=
# Mock only: which fixture it returns (invoice, officialNotice, contract, fraudulentInvoice,
# unreadable) and how long it takes in ms (to see the progress screen or load the server).
LLM_MOCK_FIXTURE=
LLM_MOCK_DELAY_MS=
# Apps below this major.minor.patch get 426 upgrade_required. Empty: every version.
MIN_APP_VERSION=
# HMAC key for device ids in server logs. Set it as a sensitive EAS variable for preview and
# production; empty uses a development key anyone can reproduce.
DEVICE_ID_HASH_KEY=
# Counter store for limits and beta metrics: an Upstash Redis database in the EU (SPEC §8.3).
# Empty: counters in the dev server's memory. Sensitive EAS variables on every deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Analysis attempts per IP address per hour (default 60) and the daily model budget in USD
# (empty: no cap).
IP_ATTEMPTS_PER_HOUR=
DAILY_BUDGET_USD=
# Bearer token of GET /api/v1/metrics, at least 32 characters. Empty: the route answers 404.
METRICS_TOKEN=
