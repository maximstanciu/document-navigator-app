# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* variables reach the app,
# and they are inlined into the bundle — never put secrets here.
# Read them through src/lib/env.ts, not process.env directly.

# Origin of this app's API routes (/api/v1/*): an EAS Hosting deployment, or the dev server
# reachable from the device. Only analysis and limits use it; local data never does.
EXPO_PUBLIC_API_URL=
