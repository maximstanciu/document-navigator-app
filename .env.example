# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* variables reach the app,
# and they are inlined into the bundle — never put secrets here.
# Read them through src/lib/env.ts, not process.env directly.

# Origin of this app's API routes (/api/v1/*): an EAS Hosting deployment, or the dev server
# reachable from the device. Only analysis and limits use it; local data never does.
EXPO_PUBLIC_API_URL=

# --- Server only (API routes, read in src/server) ---------------------------------------------
# The dev server reads them from .env.local; `eas deploy` uploads .env.local too, and EAS
# environment variables (`--environment`) take precedence. Keys go into EAS, not into files.

# LLM provider of /api/v1/analyze. Empty: MockLlmProvider, which returns synthetic fixtures.
LLM_PROVIDER=
# Mock only: which fixture it returns (invoice, officialNotice, contract, fraudulentInvoice,
# unreadable) and how long it takes in ms (to see the progress screen or load the server).
LLM_MOCK_FIXTURE=
LLM_MOCK_DELAY_MS=
# Apps below this major.minor.patch get 426 upgrade_required. Empty: every version.
MIN_APP_VERSION=
