{
  "expo": {
    "name": "DocNavigator",
    "slug": "docnavigator",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "docnavigator",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.stanciu.docnavigator",
      "deploymentTarget": "16.4",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.stanciu.docnavigator",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "ru": "./src/lib/i18n/native/ru.json",
      "en": "./src/lib/i18n/native/en.json"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Onest",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/onest/400Regular/Onest_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/onest/500Medium/Onest_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/onest/600SemiBold/Onest_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/onest/700Bold/Onest_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "JetBrainsMono",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/jetbrains-mono/500Medium/JetBrainsMono_500Medium.ttf",
                    "weight": 500
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/onest/400Regular/Onest_400Regular.ttf",
              "./node_modules/@expo-google-fonts/onest/500Medium/Onest_500Medium.ttf",
              "./node_modules/@expo-google-fonts/onest/600SemiBold/Onest_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/onest/700Bold/Onest_700Bold.ttf",
              "./node_modules/@expo-google-fonts/jetbrains-mono/500Medium/JetBrainsMono_500Medium.ttf"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "DocNavigator uses the camera to scan your documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DocNavigator opens the photos you choose to add them as pages of a document.",
          "cameraPermission": "DocNavigator uses the camera to scan your documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/jpeg",
              "image/png",
              "image/heic",
              "image/heif"
            ],
            "multipleShareMimeTypes": ["image/jpeg", "image/png", "image/heic", "image/heif"]
          }
        }
      ],
      "./plugins/with-share-history-guard",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "DocNavigator adds the deadlines you choose to your calendar.",
          "writeOnlyCalendarPermission": "DocNavigator adds the deadlines you choose to your calendar.",
          "remindersPermission": false,
          "writeOnlyAccess": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0860BF",
          "enableRemoteNotifications": true
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["ru", "en"],
          "supportsRTL": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2308c906-b62b-4697-99e5-99f4363eecc0"
      }
    },
    "owner": "maximst",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2308c906-b62b-4697-99e5-99f4363eecc0"
    }
  }
}
