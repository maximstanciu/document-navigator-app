{
  "expo": {
    "name": "DocNavigator",
    "slug": "docnavigator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "docnavigator",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.stanciu.docnavigator",
      "deploymentTarget": "16.4",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.stanciu.docnavigator",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "ru": "./src/lib/i18n/native/ru.json",
      "en": "./src/lib/i18n/native/en.json"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "DocNavigator uses the camera to scan your documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DocNavigator opens the photos you choose to add them as pages of a document.",
          "cameraPermission": "DocNavigator uses the camera to scan your documents.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#208AEF",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["ru", "en"],
          "supportsRTL": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2308c906-b62b-4697-99e5-99f4363eecc0"
      }
    },
    "owner": "maximst",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2308c906-b62b-4697-99e5-99f4363eecc0"
    }
  }
}
